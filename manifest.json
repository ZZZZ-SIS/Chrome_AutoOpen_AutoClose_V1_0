{
  "manifest_version": 3,
  "name": "定时静默开关网页 · 自动刷新与日志",
  "short_name": "开关网页与刷新",
  "version": "1.0.0",
  "description": "两套独立定时任务：静默打开网址并延时关闭；定时刷新指定标签页或窗口的所有网页。可查看和隐藏执行日志。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "定时开关网页 · 自动刷新 · 执行日志",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
